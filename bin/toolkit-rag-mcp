#!/usr/bin/env python3
"""Launch the local RAG server from any working directory or symlink."""
import os
from pathlib import Path
import sys

if sys.version_info < (3, 11):
    raise SystemExit('ai-toolkit requires Python 3.11 or newer.')
code = Path(__file__).resolve().parents[1]
root = Path(os.environ.get('AI_TOOLKIT_HOME', code)).expanduser().resolve()
python = root / 'runtime/search/bin/python'
executable = os.environ.get('TOOLKIT_PYTHON') or (str(python) if python.is_file() else sys.executable)
os.execv(executable, [executable, str(code / 'rag_server.py'), *sys.argv[1:]])
